<th>\n                <h3>Subhlakshmi</h3>\n              </th>\n              <td>\n                <p><b>Subhlakshmi Finance Private Limited</b></p>\n                <p>Unit No. 904A & 904B, 9th Floor, Tower-C Unitech Cyber Park,</p>\n                <p>Sector-39, Gurugram 122003 (Haryana)</p>\n                <p>Email: info@subhlakshmi.in</p>\n              </td>\n            </tr>\n          </table>\n  \n          \x3c!-- Borrower and Loan Details --\x3e\n          <table>\n            <tr>\n              <td rowspan=\"5\"></td>\n              <td>Borrower: RINKU<br>Co Borrower: KAVITA DEVI</td>\n              <td>Sanction Date: 16/10/2016<br>Disb Date: 17/10/2016</td>\n              <td colspan=\"2\">In case of complaint/suggestion you may call Helpline<br>(Tel no. 0124-4233318) Toll Free No:-18008913318</td>\n            </tr>\n            <tr>\n              <td>Customer ID: 1<br>Loan ID: 1</td>\n              <td>Loan Amount (Rs): 50,000/-<br>Processing fees (Rs.):590.00/-<br>ROI: 29.54% (Reducing)</td>\n              <td colspan=\"2\">Branch: KARNAL<br>Center No.: 502.00</td>\n            </tr>\n            <tr>\n              <td>Insurance (Rs.): 0.00/-<br>HospiCash (Rs.): 0.00/-</td>\n              <td>GPA (Rs): 0.00/-<br>GST on GPA (Rs.): 0.00/-</td>\n              <td colspan=\"2\">Collection Address: UCHANA P.O<br>KARAN LAKE, UCHANA (60)</td>\n            </tr>\n            <tr>\n              <td>Address: 103, KALWA HERI, KARNAL</td>\n              <td>Client confirms that his/her yearly household income is above Rs. 3,00,000/-<br>Purpose of Loan: Dairy and Livestock</td>\n              <td colspan=\"2\">Ceriter Meeting: 10:30 AM - Monday<br>No. of Installments: 36</td>\n            </tr>\n            <tr>\n              <td colspan=\"3\">In case of death of borrower or Co-borrower outstanding amount shall be settled/recovered as per Insurance Policy</td>\n            </tr>\n          </table>\n  \n          \x3c!-- Installment Details --\x3e\n          <h3>Installment Details</h3>\n          <table>\n            <thead>\n              <tr>\n                <th>Inst No.</th>\n                <th>Meeting Day</th>\n                <th>Opening Principal</th>\n                <th>Inst Amt.</th>\n                <th>Interest</th>\n                <th>Principal</th>\n                <th>B.O.P</th>\n                <th>Fore Close</th>\n                <th>Amt Recd</th>\n                <th>Amt Recd On</th>\n                <th>(P/A)</th>\n                <th>Signature</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>1</td>\n                <td>01/11/2016</td>\n                <td>50,000</td>\n                <td>1,700</td>\n                <td>568</td>\n                <td>1,132</td>\n                <td>48,868</td>\n                <td>52,500</td>\n                <td>1,700</td>\n                <td>02/11/2016</td>\n                <td></td>\n                <td>Praveen Sharma</td>\n              </tr>\n              \x3c!-- Additional rows can be added here --\x3e\n            </tbody>\n          </table>\n  \n          \x3c!-- Footer --\x3e\n          <div class=\"footer\">\n            <div style=\"display: flex; justify-content: space-between;\">\n              <div>Signature of Borrower</div>\n              <div>Signature of F.L.O</div>\n              <div>Signature of BDM</div>\n            </div>\n          </div>\n  \n          \x3c!-- Loan Utilization Check --\x3e\n          <table>\n            <tr>\n              <td colspan=\"4\" style=\"text-align: center;\">Loan Utilization Check</td>\n            </tr>\n            <tr>\n              <td>Utilization Level:</td>\n              <td>Satisfactory:</td>\n              <td>Average:</td>\n              <td>Unsatisfactory:</td>\n            </tr>\n            <tr>\n              <td>LUC Date:</td>\n              <td>LUC Done By:</td>\n              <td>Client Sign:</td>\n              <td>Staff Sign:</td>\n            </tr>\n          </table>\n        </body>\n      </html>\n    ";try{var t={html:e,fileName:"passbook_1",directory:'Documents'},n=yield h.default.convert(t);l.Alert.alert('Success','Passbook PDF has been generated'),x.default.open({title:'Share Passbook',url:`file://${n.filePath}`,type:'application/pdf'})}catch(e){l.Alert.alert('Error','Could not generate the PDF'),console.error('PDF Generation Error',e)}try{var o={html:e,fileName:`passbook_${L}`,directory:'Documents'},r=yield h.default.convert(o);l.Alert.alert('Success','Passbook PDF has been generated'),x.default.open({title:'Share Passbook',url:`file://${r.filePath}`,type:'application/pdf'})}catch(e){l.Alert.alert('Error','Could not generate the PDF'),console.error('PDF Generation Error',e)}}));return function(){return e.apply(this,arguments)}})(),K=function(){G((function(e){return!e})),M||setTimeout((function(){var e;null==(e=z.current)||e.scrollToOffset({offset:0,animated:!0})}),400)};return(0,b.jsxs)(i.default,{header:!1,children:[(0,b.jsx)(a.default,{screenName:'Loan Details'}),(0,b.jsxs)(l.View,{style:p.textView,children:[(0,b.jsx)(l.TextInput,{placeholder:"Enter Loan ID to search...",value:L,onChangeText:D,placeholderTextColor:s.default.colors.LIGHTGRAY,style:p.textInput,keyboardType:"decimal-pad",keyboardAppearance:"light",maxLength:10}),(0,b.jsx)(l.TouchableOpacity,{onPress:O,style:{position:'absolute',right:-5,top:-5,padding:8,borderRadius:50,backgroundColor:'#fff',borderWidth:1,borderColor:s.default.colors.LIGHTGRAY},children:(0,b.jsx)(c.default,{name:"magnify",size:30,color:s.default.colors.PRIMARY_LIGHT,style:{backgroundColor:s.default.colors.BLUE,borderRadius:30,padding:5}})})]}),(0,b.jsx)(l.ScrollView,{style:p.container,children:null!=(e=Object.keys(v))&&e.length?(0,b.jsx)(b.Fragment,{children:(0,b.jsx)(l.View,{style:{backgroundColor:s.default.colors.BACKGROUND,flex:1},children:(0,b.jsxs)(l.View,{style:[p.detailsRow,{flexDirection:'column'}],children:[(0,b.jsxs)(l.View,{style:p.d